{
  "name": "dsh-agent-policy",
  "version": "0.1.8",
  "description": "Shared Claw/session policy schema, preset bases, MCP init defaults. Does not deny tools. 策略契约：schema / 预设基类 / MCP 初始化默认，不执行拦截。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "agent", "policy"],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./schema": "./policy-schema.mjs",
    "./store": "./policy-store.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "policy-schema.mjs",
    "policy-store.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
